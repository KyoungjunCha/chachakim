<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chachakim.chakimcha.user.mapper.UserMapper">
    
   <!-- 유저 리스트 조회 -->
  <select id="list" resultType="com.chachakim.chakimcha.user.vo.UserVO">
    SELECT * FROM user
  </select>

  <!-- 특정 유저 조회 -->
  <select id="view" parameterType="int" resultType="com.chachakim.chakimcha.user.vo.UserVO">
    SELECT * FROM user WHERE id = #{user_Id}
  </select>

  <!-- 로그인 -->
  <select id="login" parameterType="map" resultType="com.chachakim.chakimcha.user.vo.UserVO">
    <!-- SELECT * FROM user WHERE id = #{id} AND password = #{password} -->
    SELECT * FROM user WHERE id = #{id}
  </select>

  <!-- 유저 등록 -->
  <insert id="join" parameterType="com.chachakim.chakimcha.user.vo.UserVO">
    INSERT INTO user (id, password, email, nickname, telNumber, address, address_detail, profile_image, gender, birth, permission)
    VALUES (#{id}, #{password}, #{email}, #{nickname}, #{telNumber}, #{address}, #{address_detail}, #{profile_image}, #{gender}, #{birth}, #{permission})
  </insert>

  <!-- 이메일 존재 여부 확인 -->
  <select id="findByUsername" resultType="com.chachakim.chakimcha.user.vo.UserVO" parameterType="String">
    SELECT * FROM user WHERE id = #{id}
  </select>

  <select id="countByEmail" parameterType="String" resultType="int">
    SELECT COUNT(*) FROM user WHERE email = #{email}
  </select>

</mapper>
